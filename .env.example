# Life OS environment template
# Never place real credentials in this file.

N8N_HOST=your-domain.example.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://your-domain.example.com/
N8N_EDITOR_BASE_URL=https://your-domain.example.com/
N8N_RESTRICT_FILE_ACCESS_TO=/files
LIFE_OS_STATUS_TOKEN=replace-with-a-dedicated-random-token-at-least-32-characters
