{
  "schema_version": "1.0",
  "workflow_file": "workflow.json",
  "approval_file": "APPROVAL.md",
  "workflow_name": "Life OS - Slack Resource Inbox Adapter",
  "must_import_inactive": true,
  "slack": {
    "workspace_id": "T0BLLQ18E5C",
    "channel_id": "C0BPQBNTK8R",
    "channel_name": "life-os-resource-inbox",
    "channel_private": true,
    "bot_event": "message.groups",
    "oauth_scopes": [
      "groups:history"
    ]
  },
  "credential_bindings": [
    {
      "node": "Watch Private Resource Inbox",
      "credential_type": "slackApi",
      "binding": null
    },
    {
      "node": "Forward to Authenticated Capture Webhook",
      "credential_type": "httpHeaderAuth",
      "binding": null,
      "reuse_existing_capture_processor_credential": true
    }
  ],
  "handoff": {
    "method": "POST",
    "url": "http://127.0.0.1:5678/webhook/life-os/capture",
    "network_scope": "n8n-container-loopback",
    "authentication": "httpHeaderAuth"
  },
  "deduplication": {
    "node": "Suppress Previously Captured Message",
    "operation": "removeItemsSeenInPreviousExecutions",
    "key_expression": "={{ $json.deduplication_key }}",
    "history_size": 10000,
    "discarded_output_connected": false
  },
  "production_invariants": {
    "capture_processor_active": true,
    "capture_processor_must_not_be_modified": true,
    "n8n_container_identity_must_not_change": true,
    "no_compose_recreation": true
  },
  "activation_gate": "all acceptance checks in DEPLOYMENT.md pass",
  "rollback": "deactivate only the Slack Resource Inbox adapter"
}
